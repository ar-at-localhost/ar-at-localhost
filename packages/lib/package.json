{
  "name": "lib",
  "version": "0.0.3",
  "private": true,
  "description": "A simple example library built by tsdown",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./env.d.ts": "./env.d.ts"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json",
      "./env.d.ts": "./env.d.ts"
    }
  },
  "scripts": {
    "check": "pnpm format && pnpm lint && pnpm typecheck",
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "format": "oxfmt",
    "format:fix": "oxfmt --write",
    "fix": "pnpm format:fix && pnpm lint:fix",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:cov": "vitest --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ngneat/falso": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@tanstack/svelte-query": "^6.3.9",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.3.4",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/svelte-query": "^6.3.9"
  },
  "peerDependenciesMeta": {
    "@tanstack/svelte-query": {
      "optional": true
    }
  }
}
