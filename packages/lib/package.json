{
  "name": "lib",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "A simple example library built by tsdown",
  "files": [
    "dist"
  ],
  "dependencies": {
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@ngneat/falso": "^8.0.2",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "falso": "^0.0.0",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.3.4",
    "vitest": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./env.d.ts": "./env.d.ts"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json",
      "./env.d.ts": "./env.d.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check": "pnpm format && pnpm lint && pnpm typecheck",
    "dev": "tsdown --watch",
    "format": "oxfmt",
    "format:fix": "oxfmt --write",
    "fix": "pnpm format:fix && pnpm lint:fix",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:cov": "vitest --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  }
}
