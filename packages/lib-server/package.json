{
  "name": "lib-server",
  "version": "0.0.3",
  "private": true,
  "description": "Library of server side shared artifacts",
  "homepage": "https://github.com/ar-at-localhost/ar-at-localhost",
  "bugs": {
    "url": "https://github.com/ar-at-localhost/ar-at-localhost/issues"
  },
  "license": "GPL-v3.0",
  "author": "Ahmad Raza <pro.se.ahmad.raza.1@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ar-at-localhost/ar-at-localhost.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "compile-templates": "node src/compile-mjml.ts",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "bumpp",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "globby": "^16.2.4",
    "lib": "workspace:*",
    "mjml": "^5.4.1",
    "mustache": "^4.2.0",
    "nodemailer": "catalog:",
    "resend": "catalog:"
  },
  "devDependencies": {
    "@ngneat/falso": "catalog:",
    "@types/mjml": "^5.0.0",
    "@types/mustache": "^4.2.6",
    "@types/node": "catalog:",
    "bumpp": "^12.3.0",
    "fastify": "catalog:",
    "mongodb": "catalog:",
    "mongodb-client-encryption": "catalog:",
    "mongoose": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "valibot": "catalog:",
    "vite": "^8.3.4",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@ngneat/falso": "*",
    "fastify": "catalog:",
    "mongodb": "*",
    "mongodb-client-encryption": "*",
    "mongoose": "*",
    "valibot": "*"
  }
}
