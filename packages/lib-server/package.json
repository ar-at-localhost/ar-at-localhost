  "repository": {
    "type": "git",
    "url": "git+https://github.com/ar-at-localhost/ar-at-localhost.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./env.d.ts": "./env.d.ts"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json",
      "./env.d.ts": "./env.d.ts"
    }
  },
  "scripts": {
    "compile-templates": "node src/compile-mjml.ts",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "bumpp",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@neondatabase/serverless": "^1.2.0",
    "@valibot/to-json-schema": "^1.8.0",
    "drizzle-orm": "1.0.0-rc.5",
    "fastify-plugin": "^6.0.1",
    "globby": "^16.2.4",
    "lib": "workspace:*",
    "mjml": "^5.4.1",
    "mustache": "^4.2.0",
    "nodemailer": "catalog:",
    "pg": "^8.23.1",
    "resend": "catalog:"
  },
  "devDependencies": {
    "@ngneat/falso": "catalog:",
    "@types/mjml": "^5.0.0",
    "@types/mustache": "^4.2.6",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "bumpp": "^12.3.0",
    "drizzle-kit": "^1.0.0-rc.5",
    "fastify": "catalog:",
    "neon": "^8.10.3",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "valibot": "catalog:",
    "vite": "^8.3.4",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@ngneat/falso": "*",
    "fastify": "catalog:",
    "valibot": "*"
  }
