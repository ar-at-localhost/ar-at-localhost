<!-- TEMPLATE SYNTAX: mustache -->
<mjml>
  <mj-head>
    <mj-title>Ahmad Raza - A quick request for feedback</mj-title>
    <mj-font href="https://fonts.googleapis.com/css?family=Overpass" name="Overpass" />

    <mj-attributes>
      <mj-all color="#101828" font-family="Overpass, Arial, sans-serif"></mj-all>
    </mj-attributes>

    <mj-style>
      p,
      div {
        line-height: 1.25 !important;
      }

      li::before,
      li::after {
        content: "" !important;
        padding: 0 !important;
        margin: 0 !important;
        text-indent: 0 !important;
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#f1f5f9">
    <mj-section background-color="#cad5e2">
      <mj-column vertical-align="middle">
        <mj-image width="64px" src="https://ar-at-localhost.site/favicon.png"></mj-image>
      </mj-column>
    </mj-section>

    <mj-section>
      <mj-column>
        <mj-text>
          <b>Hi {{ first_name }},</b>
        </mj-text>

        <mj-text>
          I hope you are doing well. I'm updating my professional portfolio and would appreciate if
          you take a few minutes and share a few words about your experience working with me. Your
          feedback helps me showcase my work to potential client.
        </mj-text>

        <mj-text>
          If you'd prefer not to participate, you can simply ignore this email - no action is
          required.
        </mj-text>

        <mj-button href="{{ links.cta }}" color="white">Share your thoughts</mj-button>
      </mj-column>
    </mj-section>

    <mj-section>
      <mj-column>
        <mj-text>
          <h3>Data Privacy Policy</h3>
          <p>Here's how your information is handled:</p>
          <mj-raw>
            <ul> <li>Your first name, last name initial, company name, and testimonial may be
            displayed publicly on websites.</li> <li>Your email is only used to manage this request
            and is deleted once you submit your testimonial or the request expires.</li> <li> This
            lunk automatically expires in 30 days, removing the request and all associated
            information. </li> <li>You can use the same link to delete your request at any time
            before submitting your testimonial.</li> </ul>
          </mj-raw>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section>
      <mj-column>
        <mj-text>
          Best regards,<br />
          Ahmad Raza
        </mj-text>
      </mj-column>
    </mj-section>

    {{#links}}
    <mj-section>
      <mj-column>
        <mj-social>
          {{#whatsapp}}
          <mj-social-element
            href="{{whatsapp}}"
            src="https://ar-at-localhost.site/brand-whatsapp.png"
          />
          {{/whatsapp}}

          {{#linkedin}}
          <mj-social-element
            href="{{linkedin}}"
            src="https://ar-at-localhost.site/brand-linkedin.png"
          />
          {{/linkedin}}

          {{#upwork}}
          <mj-social-element
            href="{{upwork}}"
            src="https://ar-at-localhost.site/brand-upwork.png"
          />
          {{/upwork}}

          {{#fiverr}}
          <mj-social-element
            href="{{fiverr}}"
            src="https://ar-at-localhost.site/brand-fiverr.png"
          />
          {{/fiverr}}
        </mj-social>
      </mj-column>
    </mj-section>
    {{/links}}
  </mj-body>
</mjml>
