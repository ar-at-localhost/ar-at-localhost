{
  "name": "lib",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "A simple example library built by tsdown",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:cov": "vitest --coverage",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@ngneat/falso": "^8.0.2",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "falso": "^0.0.0",
    "fastify": "catalog:",
    "mongoose": "^9.11.0",
    "tsdown": "^0.22.5",
    "typescript": "^7.0.2",
    "valibot": "*",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "fastify": "*",
    "mongoose": "*",
    "valibot": "*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./env.d.ts": "./src/env.d.ts"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json",
      "./env.d.ts": "./src/env.d.ts"
    }
  }
}
