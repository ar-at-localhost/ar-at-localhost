{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": [
    "CONTACT_PERSON_NAME",
    "CONTACT_PERSON_EMAIL",
    "CORS_ALLOW",
    "CHROMIUM_PATH",
    "DB_URI",
    "DOCTL_TOKEN",
    "MAIL_FROM",
    "MAIL_SECURE",
    "MAIL_SERVER",
    "MAIL_PORT",
    "MAIL_USER",
    "MAIL_PWD",
    "NODE_ENV",
    "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD",
    "PORT",
    "PUBLIC_SRV_URL",
    "PUBLIC_TURNSTILE_SITEKEY",
    "RESEND_API_KEY",
    "SECRETSPEC_PROFILE",
    "SITE_APP_ID",
    "SOPS_AGE_KEY",
    "TURBO_TOKEN",
    "TURNSTILE_SECRET_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ]
    },
    "check": {
      "dependsOn": [
        "^format",
        "^lint",
        "^typecheck"
      ]
    },
    "fix": {
      "dependsOn": [
        "^format:fix",
        "^lint:fix"
      ]
    },
    "format": {
      "dependsOn": [
        "^format"
      ]
    },
    "format:fix": {
      "dependsOn": [
        "^format:fix"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "lint:fix": {
      "dependsOn": [
        "^lint:fix"
      ]
    },
    "quality": {
      "dependsOn": [
        "build",
        "check",
        "test",
        "test:e2e"
      ]
    },
    "test": {
      "dependsOn": [
        "^test"
      ]
    },
    "test:e2e": {
      "dependsOn": [
        "^test:e2e"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  },
  "globalDependencies": [
    "secrets/**/*",
    "secretspec.toml",
    ".sops.yaml",
    "nix/images.nix",
    "nix/lib.nix"
  ],
  "concurrency": "3"
}
