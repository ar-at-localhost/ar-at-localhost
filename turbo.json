{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ]
    },
    "check": {
      "dependsOn": [
        "^format",
        "^lint",
        "^typecheck",
      ]
    },
    "fix": {
      "dependsOn": [
        "^format:fix",
        "^lint:fix",
      ]
    },
    "format": {
      "dependsOn": [
        "^format",
      ]
    },
    "format:fix": {
      "dependsOn": [
        "^format:fix",
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint",
      ]
    },
    "lint:fix": {
      "dependsOn": [
        "^lint:fix",
      ]
    },
    "test": {
      "dependsOn": [
        "^test",
      ],
      "env": [
        "CONTACT_PERSON_NAME",
        "CONTACT_PERSON_EMAIL",
        "MAIL_FROM",
        "MAIL_SECURE",
        "MAIL_SERVER",
        "MAIL_PORT",
        "MAIL_USER",
        "MAIL_PWD",
        "MONGO_CRYPT_LIB",
        "MONGODB_DB",
        "MONGODB_DEK_CONTACT_EMAIL",
        "MONGODB_DEK_CONTACT_MESSAGE",
        "MONGODB_ENC_KEY",
        "MONGODB_URI",
        "NODE_ENV",
        "PORT",
        "PUBLIC_SRV_URL"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck",
      ]
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
