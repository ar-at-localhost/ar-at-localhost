{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ]
    },
    "check": {
      "dependsOn": [
        "^format",
        "^lint",
        "^typecheck",
      ]
    },
    "fix": {
      "dependsOn": [
        "^format:fix",
        "^lint:fix",
      ]
    },
    "format": {
      "dependsOn": [
        "^format",
      ]
    },
    "format:fix": {
      "dependsOn": [
        "^format:fix",
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint",
      ]
    },
    "lint:fix": {
      "dependsOn": [
        "^lint:fix",
      ]
    },
    "test": {
      "dependsOn": [
        "^test",
      ],
      "env": [
        "MONGODB_URI"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck",
      ]
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
