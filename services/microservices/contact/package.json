{
  "name": "srv-contact",
  "version": "0.0.1",
  "private": true,
  "description": "Create contact API service",
  "homepage": "https://github.com/ar-at-localhost/ar-at-localhost",
  "bugs": {
    "url": "https://github.com/ar-at-localhost/ar-at-localhost/issues"
  },
  "license": "GPL-v3.0",
  "author": "Ahmad Raza <pro.se.ahmad.raza.1@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ar-at-localhost/ar-at-localhost.git"
  },
  "bin": {
    "api": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "bin": {
      "api": "./dist/index.mjs"
    },
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check": "pnpm format && pnpm lint && pnpm typecheck",
    "dev": "node --watch src/index.ts",
    "fix": "pnpm format:fix && pnpm lint:fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "openapi": "node ./src/specs.ts",
    "start": "pnpm build && node dist/index.mjs",
    "test": "vitest run",
    "test:cov": "vitest --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "fastify": "catalog:",
    "lib": "workspace:*",
    "lib-server": "workspace:*",
    "mongodb": "catalog:",
    "mongodb-client-encryption": "catalog:",
    "mongoose": "catalog:",
    "resend": "catalog:",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.3.3",
    "vitest": "catalog:"
  },
  "inlinedDependencies": {
    "@fastify/swagger": "9.9.2",
    "@valibot/to-json-schema": "1.8.0",
    "debug": "4.4.3",
    "fast-uri": "3.1.8",
    "fastify-plugin": "6.0.1",
    "has-flag": "4.0.0",
    "json-schema-resolver": "3.0.0",
    "ms": "2.1.3",
    "mustache": "4.2.0",
    "nodemailer": "10.1.0",
    "rfdc": "1.4.1",
    "supports-color": "7.2.0",
    "yaml": "2.9.1"
  }
}
