{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "astro": true,
  "sortImports": true,
  "ignorePatterns": [
    "dist/**",
    "*.min.js",
    ".devenv/**/*",
    ".direnv/**/*",
    ".turbo/**",
    ".terraform/**",
    ".pnp.*",
    ".yarn/**",
    ".devcontainer/devcontainer.json",
    "node_modules",
    "result*",
    "packages/lib-server/src/templates/*.html",
    "secrets/**",
    "services/**/openapi.json"
  ]
}
