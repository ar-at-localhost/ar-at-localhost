---
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "ui/components/card";
import { IconLoader2 } from '@tabler/icons-react';
---

<div id="contact-form-placeholder" class="rounded flex flex-row items-center justify-center relative left-0 right-0 fade-in fade-out">
  <Card className='h-140 w-full'>
    <CardHeader>
      <CardTitle>Send a project brief</CardTitle>
    </CardHeader>

    <CardContent className="h-full flex flex-col items-center justify-center gap-2">
      <IconLoader2 className="animate-spin" size="36" />
      <CardDescription className="text-center">Need assistance with a project? Send me a quick brief and I&rsquo;ll get back to you soon.</CardDescription>
    </CardContent>
  </Card>
</div>
