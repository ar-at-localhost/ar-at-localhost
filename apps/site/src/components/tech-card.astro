---
import { cn } from 'cn';
const { extraClass } = Astro.props;
const cls = cn("text-center flex flex-col items-center justify-center gap-2", extraClass)
---

<div class={cls}>
  <span class="size-12 md:size-16 lg:size-24">
    <slot name="icon" />
  </span>

  <span class="font-bold md:text-xl lg:text-4xl ">
    <slot />
  </span>

  <slot name="desc" />
</div>
