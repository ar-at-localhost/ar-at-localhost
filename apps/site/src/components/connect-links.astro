---
import { cn } from 'cn';
import { LinkBtn } from '../components/LinkBtn';
import Fiverr from '../assets/icons/brand-fiverr.svg';
import Github from '../assets/icons/brand-github.svg';
import LinkedIn from '../assets/icons/brand-linkedin.svg';
import Mail from '../assets/icons/mail.svg';
import Upwork from '../assets/icons/brand-upwork.svg';
import Whatsapp from '../assets/icons/brand-whatsapp.svg';

const { extraClass } = Astro.props;

const cls = cn(
  "w-full flex flex-row items-center justify-center gap-2",
  extraClass
)
---
<div class={cls}>
  <LinkBtn title="Email address" href="mailto:pro.se.ahmad.raza.1@gmail.com">
    <Mail class="dark:text-gray-100" />
  </LinkBtn>

  <LinkBtn title="Whatsapp" href="https://wa.me/923011353415">
    <Whatsapp class="dark:text-gray-100" />
  </LinkBtn>
  
  <LinkBtn title="Github" href="https://github.com/ar-at-localhost" target="_blank">
    <Github class="dark:text-gray-100" />
  </LinkBtn>

  <LinkBtn title="LinkedIn" href="https://linkedin.com/in/ar124officialwd" target="_blank">
    <LinkedIn class="dark:text-gray-100" />
  </LinkBtn>

  <LinkBtn title="Fiverr" href="https://www.fiverr.com/s/gvvXllo" target="_blank">
    <Fiverr class="dark:text-gray-100" />
  </LinkBtn>

  <LinkBtn title="Upwork" href="https://www.upwork.com/freelancers/~013dd6d70690822d44" target="_blank">
    <Upwork class="dark:text-gray-100" />
  </LinkBtn>
</div>
