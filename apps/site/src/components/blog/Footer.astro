---
const today = new Date();
import SocialLinks from './SocialLinks.astro';
---

<footer class="bg-white text-neutral-500 dark:bg-stone-700 dark:text-neutral-50">
  <SocialLinks />

  <div class="mt-4">
    <a href="/blog.xml" class="underline">Subscribe via RSS</a> to get new posts in your feed reader.
  </div>

  <div class="mt-2">
    &copy; {today.getFullYear()} Ahmad Raza &lt;ar-at-localhost&gt;. All rights reserved.
  </div>
</footer>

<style>
	footer {
		padding: 2em 1em;
		text-align: center;
	}
</style>
