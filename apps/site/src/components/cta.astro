---
import { IconRocket } from '@tabler/icons-react';
import { Button } from 'ui/components/button';
import ConnectLinks from '../components/connect-links.astro'
import Send from '../assets/icons/send.svg';
---


<div class="connect-links flex flex-col p-8 py-16 lg:py-32 bg-green-950 dark:bg-blue-950 text-white">
  <div class="flex flex-col items-center justify-center text-center gap-4">
    <IconRocket className="size-8 md:size-16 lg:size-32" />
    <h2 class="uppercase font-bold text-2xl lg:text-4xl">Getting started is easy</h2>
    <h2 class="max-w-2/3 font-medium text-md md:text-lg">Send me a brief via the form, email, WhatsApp, LinkedIn, Upwork or Fiverr and I'll get back to you soon.</h2>

    <div class="flex flex-col items-stretch gap-2">
      <Button size="lg" className="connect-link cursor-pointer bg-gray-500! dark:bg-gray-600!">
        <Send class="dark:text-gray-100" />
        <span class="text-white">Send a project brief via form</span>
      </Button>

      <ConnectLinks />
    </div>
  </div>
</div>
