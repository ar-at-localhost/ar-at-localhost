---
import Bullet from './bullet.astro';
import { Button } from "ui/components/button";
import { LayoutTemplate, Settings, SquareDashed, Rocket } from '@lucide/astro';
import {Card, CardTitle} from "ui/components/card";
import Section from './section.astro';
import ServiceCard from './service-card.astro';
import Testmonial from './testimonial.astro';
---

<Section extraClass="md:bg-linear-to-tr text-stone-900">
  <div class="flex flex-col py-8 md:py-16 gap-8">
    <div class="p-16 md:px-32 lg:px-0 flex flex-col gap-4 lg:gap-auto items-center justify-center dark:text-gray-50">
      <LayoutTemplate size="192"/>

      <div class="flex flex-col gap-4 items-center">
        <h2 class="font-bold text-center text-xl md:text-xl lg:text-4xl dark:text-gray-100">I build every part of an application &ndash; with <span class="uppercase font-bold">quality</span>.</h2>
      </div>
    </div>

    <div class="w-full flex flex-wrap flex-col items-center justify-center gap-4 lg:flex-row lg:items-stretch lg:gap-auto">
      <ServiceCard title="Back-End Services">
        <Settings size="96" />
        <div slot="desc" class="flex flex-col gap-1">
          <Bullet>REST APIs</Bullet>
          <Bullet>Socket communication</Bullet>
          <Bullet>External systems integration</Bullet>
          <Bullet>Scripts and automations</Bullet>
          <Bullet>Microservices</Bullet>
        </div>
      </ServiceCard>

      <ServiceCard title="Front-End / UI/UX">
        <SquareDashed size="96" />
        <div slot="desc">
          <Bullet>Interactive apps</Bullet>
          <Bullet>Static Sites</Bullet>
          <Bullet>Micro-Frontends</Bullet>
          <Bullet>Server side rendering</Bullet>
          <Bullet>Back-End integrations</Bullet>
          <Bullet>Pixel Perfect UIs</Bullet>
          <Bullet>User Experience</Bullet>
        </div>
      </ServiceCard>

      <ServiceCard title="Deployments">
        <Rocket size="96"/>
        <div slot="desc">
          <Bullet>Vercel</Bullet>
          <Bullet>Heroku</Bullet>
          <Bullet>DigitalOcean</Bullet>
          <Bullet>Linux VPS Deployments</Bullet>
          <Bullet>Containers</Bullet>
          <Bullet>Microservices</Bullet>
          <Bullet>Nix & Ecosystem</Bullet>
        </div>
      </ServiceCard>
    </div>

    <Testmonial extraClass="w-9/10 md:w-[448px] lg:w-3/5">
      <span slot="avatar">J</span>
      <span slot="name">Jackson J.</span>
      <span slot="company">Rixor</span>
      <span slot="quote">I got Ahmad to help with building the initial version of my site. He was very responsive and was extremely skilled, particularly with back end work. I have some development experience so I know enough to know when someone knows what they are doing. Ahmad didn't just do the work I told him to do like a robot, but would often give feedback and suggestions on what would perhaps work better. He was also very good at keeping me updated with what he was working on instead of waiting to submit everything the day I needed it done.</span>
    </Testmonial>
  </div>
</Section>
