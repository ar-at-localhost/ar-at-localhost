---
import { Button } from "ui/components/button";
import { LayoutTemplate, Settings, SquareDashed, Rocket } from '@lucide/astro';
import {Card, CardTitle} from "ui/components/card";
import Section from './section.astro';
import ServiceCard from './service-card.astro';
import Testmonial from './testimonial.astro';
---

<Section extraClass="md:bg-linear-to-tr">
  <div class="flex flex-col py-8 md:py-16 gap-8">
    <div class="p-16 md:px-32 lg:px-0 flex flex-col lg:flex-row gap-4 lg:gap-auto items-center justify-center text-gray-700 dark:text-gray-50">
      <LayoutTemplate size="192" class="text-green-800"/>

      <div class="flex flex-col gap-4 items-center">
        <h1 class="uppercase font-bold lg:text-center md:text-xl md:text-4xl lg:text-8xl">Full Stack Services</h1>
        <p class="font-medium text-center text-xl md:text-xl lg:text-4xl dark:text-gray-100">Every component of an application is built &ndash; with <span class="uppercase font-bold">quality</span>.</p>
      </div>
    </div>

    <div class="w-full flex flex-col lg:flex-row items-center lg:items-stretch gap-4 lg:gap-auto justify-center overflow-hidden w-2/3">
      <ServiceCard title="Back-End Services">
        <Settings size="128" />
        <span slot="desc">Build performance first, reliable, reobust and secure back-end services &ndash; APIs, Logic pipelines, External systems integrations and so on.</span>
      </ServiceCard>

      <ServiceCard title="Front-End / UI/UX">
        <SquareDashed size="128" />
        <span slot="desc">Build feature rich, well interactive and dynamic front-end applications with careful UI/UX.</span>
      </ServiceCard>

      <ServiceCard title="Deployments">
        <Rocket class="size-full lg:rotate-[-45deg] lg:relative top-[-32px]" size="128"/>
        <span slot="desc">Deploy your end-2-end applications to variety of services &ndash; including Linux servers,
          Vercel, DigitalOcean...</span>
      </ServiceCard>
    </div>

    <div class="flex items-center justify-center">
      <Testmonial extraClass="w-full md:max-w-1/2">
        <span slot="avatar">J</span>
        <span slot="name">Jackson J.</span>
        <span slot="company">Rixor</span>
        <span slot="quote">I got Ahmad to help with building the initial version of my site. He was very responsive and was extremely skilled, particularly with back end work. I have some development experience so I know enough to know when someone knows what they are doing. Ahmad didn't just do the work I told him to do like a robot, but would often give feedback and suggestions on what would perhaps work better. He was also very good at keeping me updated with what he was working on instead of waiting to submit everything the day I needed it done.</span>
      </Testmonial>
    </div>
  </div>
</Section>
