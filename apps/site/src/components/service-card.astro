---
const { title, desc } = Astro.props;
import { cn } from 'cn';

const cls = cn(
  "w-9/10 md:w-[448px] p-8 pl-4 rounded border-4 border-blue-200",
  "flex flex-col items-top justify-start gap-8",
  "grid-cols-2"
);
---

<div class={cls}>
  <div class="flex flex-row items-center gap-8">
    <span>
      <slot />
    </span>

    <span class="font-medium text-2xl">{title}</span>
  </div>

  <div class="dark:text-white px-4">
    <slot name="desc" />
  </div>
</div>
