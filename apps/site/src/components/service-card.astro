---
const { title, desc } = Astro.props;
import { cn } from 'cn';

const cls = cn(
  "w-9/10 md:w-[448px] p-8 pl-4 rounded border-4 border-gray-700",
  "flex flex-row items-top justify-start gap-8"
);
---

<div class={cls}>
  <span class="text-stone-700 dark:text-orange-300 pb-4">
    <slot />
  </span>

  <div class="flex flex-col gap-4">
    <span class="font-medium text-2xl">{title}</span>
    <span class="text-justify text-gray-700 dark:text-white">
      <slot name="desc" />
    </span>
  </div>
</div>
