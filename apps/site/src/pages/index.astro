---
import '../styles/global.css';
import { Copyright, ExternalLink } from '@lucide/astro';
import AI from '../components/ai.astro'
import CTA from '../components/cta.astro'
import Hero from '../components/hero.astro'
import Services from '../components/services.astro'
import Tech from '../components/tech.astro'

const { PUBLIC_SRV_URL, PUBLIC_TURNSTILE_SITEKEY } = import.meta.env;
---

<script>
  const theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  const isDark = theme == "dark";
  document.documentElement.classList[isDark ? 'add' : 'remove']('dark');
</script>

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Ahmad Raza | ar-at-localhost</title>
    <meta name="description" content="Hire a full stack developer">

    <script is:inline	src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
	</head>

  <body class="relative smooth">
    <Hero apiBase={PUBLIC_SRV_URL} siteKey={PUBLIC_TURNSTILE_SITEKEY} />
    <Services />
    <Tech />
    <AI />
    <CTA />

    <div class="py-2 text-xs text-center flex flex-col text-gray-500 dark:text-gray-100">
      <span>
        <Copyright class="size-3 inline-block" />&nbsp;2026 &nbsp;Ahmad Raza &lt;ar-at-localhost&gt;. Designed and developed by me.
      </span>
      <span>
        This website does not track you, and its source code is available on <a href="https://github.com/ar-at-localhost/ar-at-localhost" target="_blank">Github <ExternalLink class="size-3 inline-block" /></a>.
      </span>
    </div>

    <script>
      document.querySelectorAll('button.connect-link').forEach((button) => button.addEventListener('click', () => {
        document.querySelector('#contact-form-container')?.scrollIntoView({
          behavior: 'smooth'
        });

        (document.querySelector('input[type="text"]') as HTMLInputElement)?.focus();
      }));
    </script>

    <script>
      // warm up contact service for quicker response
      fetch(`${import.meta.env.PUBLIC_SRV_URL}/contact/health`, {
        method: 'GET',
      }).then(() => null).catch(() => null);
    </script>
	</body>
</html>
