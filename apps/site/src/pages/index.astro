---
import '../styles/global.css';
import Fiverr from '../assets/icons/brand-fiverr.svg';
import Github from '../assets/icons/brand-github.svg';
import Link from '../assets/icons/external-link.svg';
import LinkedIn from '../assets/icons/brand-linkedin.svg';
import Mail from '../assets/icons/mail.svg';
import photo from '../assets/photo.jpg';
import Upwork from '../assets/icons/brand-upwork.svg';
import Whatsapp from '../assets/icons/brand-whatsapp.svg';
import { Button } from 'ui/components/button';
import { LinkBtn } from '../components/LinkBtn';
import { Copyright, ExternalLink } from '@lucide/astro';
import { Image } from 'astro:assets';
import { ContactForm } from 'ui/site/contact-form';
---

<script is:inline>
  const isDark = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  document.documentElement.classList[isDark ? 'add' : 'remove']('dark');
</script>

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro + TailwindCSS</title>
	</head>

  <body class="
     w-screen h-screen font-roboto-slab bg-linear-to-br
     text-gray-900 from-cyan-100 via-blue-100 to-blue-400
     dark:text-white dark:from-gray-900 dark:via-stone-900 dark:to-black
  ">
		<div class="flex flex-row items-center justify-around h-screen">
      <div class="w-2/5 flex flex-col gap-8 font-serif">
        <div class="flex flex-row items-center gap-8 font-roboto">
          <Image src={photo} class="size-24 rounded-full aspect-video" alt="Photo of Ahmad Raza" />

          <div class="flex flex-col gap-1">
            <h1 class="uppercase font-bold text-6xl">Ahmad Raza</h1>
            <h2 class="capitalize font-medium text-4xl tracking-wide">Full Stack developer</h2>
          </div>
        </div>

        <div class="px-2 flex flex-col gap-16">
          <div class="flex flex-col gap-2">
            <p>I am a software engineer who builds end-2-end web applications using modern technologies. I have a keen eye for details, strong problem-solving skills, and a passion for quality driven development, clean code and collaboration.</p>
            <p>

            Reach out if you need help building server-side applications, APIs, interactive web-apps, or technical consultation.
            </p>
          </div>

          <div class="flex flex-row items-center gap-2 actions">
            <LinkBtn href="mailto:pro.se.ahmad.raza.1@gmail.com">
              <Mail alt="Email icon" class="dark:text-gray-100" />
            </LinkBtn>

            <LinkBtn href="https://wa.me/923011353415">
              <Whatsapp alt="Whatsapp logo" class="dark:text-gray-100" />
            </LinkBtn>
            
            <LinkBtn href="https://github.com/ar-at-localhost" target="_blank">
              <Github alt="Github logo" class="dark:text-gray-100" />
            </LinkBtn>

            <LinkBtn href="https://linkedin.com/in/ar124officialwd" target="_blank">
              <LinkedIn alt="LinkedIn logo" class="dark:text-gray-100" />
            </LinkBtn>

            <LinkBtn  href="https://www.fiverr.com/s/gvvXllo" target="_blank">
              <Fiverr alt="Fiverr logo" class="dark:text-gray-100" />
            </LinkBtn>

            <LinkBtn href="https://www.upwork.com/freelancers/~013dd6d70690822d44" target="_blank">
              <Upwork alt="Upwork logo" class="dark:text-gray-100" />
            </LinkBtn>
          </div>
        </div>
      </div>

      <div class="px-2 py-4 w-1/4 rounded">
        <ContactForm client:only="react" />
      </div>

      <div class="absolute bottom-4 left-40 bottom-1">
        <span class="text-xs text-gray-500 dark:text-gray-100">
          <Copyright class="size-3 inline-block" />&nbsp;2026 &nbsp;Ahmad Raza &lt;ar-at-localhost&gt;. Source code is available on <a href="https://github.com/ar-at-localhost/ar-at-localhost" target="_blank">Github <ExternalLink class="size-3 inline-block" /></a>.
        </span>
      </div>
		</div>
	</body>
</html>
