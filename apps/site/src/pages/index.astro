---
import '../styles/global.css';
import logo from '../assets/logo.png';
import logoLight from '../assets/logo-light.png';
import Fiverr from '../assets/icons/brand-fiverr.svg';
import Github from '../assets/icons/brand-github.svg';
import Link from '../assets/icons/external-link.svg';
import LinkedIn from '../assets/icons/brand-linkedin.svg';
import Mail from '../assets/icons/mail.svg';
import Upwork from '../assets/icons/brand-upwork.svg';
import Whatsapp from '../assets/icons/brand-whatsapp.svg';
import { Button } from 'ui/components/button';
import { LinkBtn } from '../components/LinkBtn';
import { Copyright, ExternalLink } from '@lucide/astro';
import { Image } from 'astro:assets';
import { ContactForm } from 'ui/site/contact-form';
import AI from '../components/ai.astro'
import Section from '../components/section.astro'
import Services from '../components/services.astro'
import Tech from '../components/tech.astro'
import Testmonial from '../components/testimonial.astro';

const { PUBLIC_SRV_URL } = import.meta.env;
---

<script is:inline>
  const theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  const isDark = theme == "dark";
  document.documentElement.classList[isDark ? 'add' : 'remove']('dark');
</script>

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Ahmad Raza | ar-at-localhost</title>
    <meta name="description" content="Hire a full stack developer">
	</head>

  <body class="relative smooth">
    <Section>
      <div class="h-auto gap-8 md:gap-16 lg:gap-8 flex flex-col lg:min-h-screen lg:gap-auto lg:flex-row items-center justify-around">
        <div class="pt-24 lg:pt-0 w-3/4 lg:w-2/5 flex flex-col gap-8 md:gap-16 font-serif">
          <div class="flex flex-col md:flex-row items-center gap-8 font-roboto">
            <Image src={logo} class="dark:hidden size-16 md:size-24 rounded-full" alt="Logo - ar-at-localhost" />
            <Image src={logoLight} class="not-dark:hidden size-16 md:size-24 rounded-full" alt="Logo - ar-at-localhost" />

            <div class="flex flex-col gap-1 text-center md:text-start">
              <h1 class="uppercase font-bold text-4xl md:text-6xl">Ahmad Raza</h1>
              <h2 class="capitalize font-medium text-xl md:text-4xl tracking-wide">Full Stack developer</h2>
            </div>
          </div>

          <div class="flex flex-col gap-4 md:gap-2 text-center md:text-left">
            <p>I am a software engineer who builds end-2-end web applications using modern technologies. I have a keen eye for details, strong problem-solving skills, and a passion for quality driven development, clean code and collaboration.
            </p>

            <p>
            Reach out if you need help building server-side applications, APIs, interactive web-apps, or technical consultation.
            </p>
          </div>

          <div class="w-full md:w-auto relative left-auto top-auto md:absolute md:left-4 md:top-68 md:top-30 flex flex-row md:flex-col lg:flex-col lg:relative lg:left-auto lg:top-auto lg:flex-row items-center justify-center md:justify-start gap-2">
            <LinkBtn href="mailto:pro.se.ahmad.raza.1@gmail.com">
              <Mail alt="Email icon" class="dark:text-gray-100" />
            </LinkBtn>

            <LinkBtn href="https://wa.me/923011353415">
              <Whatsapp alt="Whatsapp logo" class="dark:text-gray-100" />
            </LinkBtn>
            
            <LinkBtn href="https://github.com/ar-at-localhost" target="_blank">
              <Github alt="Github logo" class="dark:text-gray-100" />
            </LinkBtn>

            <LinkBtn href="https://linkedin.com/in/ar124officialwd" target="_blank">
              <LinkedIn alt="LinkedIn logo" class="dark:text-gray-100" />
            </LinkBtn>

            <LinkBtn  href="https://www.fiverr.com/s/gvvXllo" target="_blank">
              <Fiverr alt="Fiverr logo" class="dark:text-gray-100" />
            </LinkBtn>

            <LinkBtn href="https://www.upwork.com/freelancers/~013dd6d70690822d44" target="_blank">
              <Upwork alt="Upwork logo" class="dark:text-gray-100" />
            </LinkBtn>
          </div>

          <div class="w-full flex flex-row items-center justify-center">
            <Testmonial rating="5.0" view="alt">
              <span slot="avatar">A</span>
              <span slot="name">Aqdas R.</span>
              <span slot="company">npmCode</span>
              <span slot="quote">
                Ahmad was consistently one of the most capable individuals I worked with. He was organized, discerning, and quick. 
                Highly Recommended!
              </span>
            </Testmonial>
          </div>
        </div>

        <div class="w-full md:w-3/4 lg:w-1/4 px-2 md:p-0" id="contact-form-container">
          <ContactForm apiBase={PUBLIC_SRV_URL} client:load />
        </div>
      </div>
    </Section>

    <Services />
    <Tech />
    <AI />

    <div class="text-center md:absolute md:text-left md:bottom-4 md:left-32 lg:bottom-4">
      <span class=" text-xs text-gray-500 dark:text-gray-100">
        <Copyright class="size-3 inline-block" />&nbsp;2026 &nbsp;Ahmad Raza &lt;ar-at-localhost&gt;. Source code is available on <a href="https://github.com/ar-at-localhost/ar-at-localhost" target="_blank">Github <ExternalLink class="size-3 inline-block" /></a>.
      </span>
    </div>

    <script>
      document.querySelectorAll('button.connect-link').forEach((button) => button.addEventListener('click', () => {
        document.querySelector('#contact-form-container')?.scrollIntoView({
          behavior: 'smooth'
        });

        document.querySelector('input[type="text"]')?.focus();
      }));
    </script>
	</body>
</html>
