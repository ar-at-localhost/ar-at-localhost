{
  "name": "cli",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "A simple example library built by tsdown",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "node src/index.ts",
    "build": "tsdown",
    "start": "tsdown && node dist/index.mjs"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "bin": "./dist/index.mjs",
  "dependencies": {
    "citty": "^0.2.2",
    "kerberos": "^7.0.0",
    "lib-server": "workspace:*",
    "mongodb": "catalog:",
    "mongodb-client-encryption": "catalog:",
    "mongoose": "catalog:"
  }
}
