{
  "name": "app-admin",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "check": "pnpm format && pnpm lint && pnpm typecheck",
    "dev": "vite dev",
    "build": "vite build",
    "fix": "pnpm format:fix && pnpm lint:fix",
    "format": "oxfmt",
    "format:fix": "oxfmt --write",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@formisch/svelte": "^1.1.1",
    "@lucide/svelte": "^1.65.0",
    "@sveltejs/adapter-static": "^4.0.1",
    "@tanstack/svelte-query": "^6.3.9",
    "bits-ui": "^2.20.2",
    "es-toolkit": "^1.53.1",
    "lib": "workspace:*",
    "ui": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "@vitest/browser-playwright": "catalog:",
    "firebase-tools": "catalog:",
    "playwright": "catalog:",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "catalog:",
    "vitest-browser-svelte": "^2.1.1"
  }
}
