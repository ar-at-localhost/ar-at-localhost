{
  "name": "apis",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "A simple example library built by tsdown",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "pnpm format && pnpm lint && pnpm typecheck",
    "dev": "node src/index.ts",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "start": "pnpm build && node dist/index.mjs",
    "test": "vitest run",
    "test:cov": "vitest --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "fastify": "catalog:",
    "lib": "workspace:*",
    "lib-server": "workspace:*",
    "mongodb": "catalog:",
    "mongodb-client-encryption": "catalog:",
    "mongoose": "catalog:",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.3.3",
    "vitest": "catalog:"
  }
}
