[Unit]
Description=ar-at-localhost API server
After=nix-daemon.service network.target multiuser.target
Requires=nix-daemon.service
Wants=network-online.target

[Service]
Type=simple
Environment="HOME=/root"
Environment="PATH=/usr/bin:/usr/sbin:/usr/local/bin:/root/.nix-profile/bin"
Environment="SECRETSPEC_PROFILE=prod"
ExecStart=/root/.nix-profile/bin/nix develop -c secretspec run --profile prod node apps/api/dist/index.mjs
WorkingDirectory=/src/ar-at-localhost
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
