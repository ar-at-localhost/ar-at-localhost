{
  "name": "api",
  "description": "API services of ar-at-localhost",
  "version": "0.0.1",
  "private": true,
  "homepage": "https://github.com/ar-at-localhost/ar-at-localhost",
  "author": "Ahmad Raza <pro.se.ahmad.raza.1@gmail.com>",
  "license": "GPL-v3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ar-at-localhost/ar-at-localhost.git"
  },
  "bugs": {
    "url": "https://github.com/ar-at-localhost/ar-at-localhost/issues"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "check": "pnpm format && pnpm lint && pnpm typecheck",
    "dev": "node src/index.ts",
    "fix": "pnpm format:fix && pnpm lint:fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "start": "pnpm build && node dist/index.mjs",
    "test": "vitest run",
    "test:cov": "vitest --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "fastify": "catalog:",
    "lib": "workspace:*",
    "lib-server": "workspace:*",
    "mongodb": "catalog:",
    "mongodb-client-encryption": "catalog:",
    "mongoose": "catalog:",
    "resend": "catalog:",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.3.3",
    "vitest": "catalog:"
  },
  "bin": {
    "api": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    },
    "bin": {
      "api": "./dist/index.mjs"
    }
  }
}
